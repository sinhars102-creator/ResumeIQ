{
  "manifest_version": 3,
  "name": "ResumeIQ – Save jobs & autofill applications",
  "version": "0.1.0",
  "description": "Save jobs from any page to ResumeIQ, see how well you fit, and autofill applications for you to review and submit.",
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open ResumeIQ" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://resume-iq-seven.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
