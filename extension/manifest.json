{
  "manifest_version": 3,
  "name": "ResumeIQ – Save jobs & autofill applications",
  "version": "0.1.0",
  "description": "Save jobs from any page to ResumeIQ, see how well you fit, and autofill applications for you to review and submit.",
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open ResumeIQ", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://www.myresumeiq.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedinCard.js"],
      "run_at": "document_idle"
    }
  ]
}
