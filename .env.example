# Get your key from https://console.anthropic.com/settings/keys
# Copy this file to .env and add your key (do not commit .env)
VITE_ANTHROPIC_API_KEY=

# API server URL for LinkedIn job search. Default in dev is http://localhost:3001.
# Only set if your server runs elsewhere (e.g. production).
# VITE_API_URL=http://localhost:3001

# Optional: for "Search LinkedIn" jobs (used after resume upload and on Job Matches).
# Prefer Apify (reliable, ~$1 per 1,000 jobs): https://apify.com/practicaltools/linkedin-jobs
# Get token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Fallback: RapidAPI LinkedIn Job Search API (many providers have discontinued).
# RAPIDAPI_KEY=

# Reactive Resume (rxresu.me) account API key — powers AI-tailored bullet
# suggestions (server-side only; never exposed to the browser).
# Get one: rxresu.me → Settings → API Keys. Also add an Anthropic Claude
# provider under Settings → Integrations so Reactive Resume's AI calls work.
RXRESUME_API_KEY=
# Reactive Resume instance. Leave unset for the hosted rxresu.me (opens in a new tab;
# it can't be embedded). Set to a self-hosted copy, e.g. http://localhost:3000, to show
# the editor inside ResumeIQ — RXRESUME_API_KEY must then come from that instance.
# RXRESUME_URL=http://localhost:3000

# Groq (console.groq.com → API Keys) – open-source models for parsing, scoring and job summaries.
# Server-side only; never exposed to the browser.
GROQ_API_KEY=
