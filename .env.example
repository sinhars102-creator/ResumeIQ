# Get your key from https://console.anthropic.com/settings/keys
# Copy this file to .env and add your key (do not commit .env)
VITE_ANTHROPIC_API_KEY=

# API server URL for LinkedIn job search. Default in dev is http://localhost:3001.
# Only set if your server runs elsewhere (e.g. production).
# VITE_API_URL=http://localhost:3001

# Optional: for "Search LinkedIn" jobs (used after resume upload and on Job Matches).
# Prefer Apify (reliable, ~$1 per 1,000 jobs): https://apify.com/practicaltools/linkedin-jobs
# Get token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Adzuna (official job-search API with India coverage) – free App ID + Key, instant signup:
# https://developer.adzuna.com/  Server-side only. Leave empty to skip Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Company career pages (Greenhouse, Lever, Ashby, Workable) need no key – the list of
# companies searched lives in server/jobBoards.js. Check them with: npm run check-sources

# Jobs repository (Supabase): every role from every source, filled by `npm run collect`.
# Supabase → Project Settings → API. The service role key is server-side only – never expose it.
# Create the tables first: run supabase/migrations/20261006000000_jobs_repository.sql in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fallback: RapidAPI LinkedIn Job Search API (many providers have discontinued).
# RAPIDAPI_KEY=

# Reactive Resume (rxresu.me) account API key — powers AI-tailored bullet
# suggestions (server-side only; never exposed to the browser).
# Get one: rxresu.me → Settings → API Keys. Also add an Anthropic Claude
# provider under Settings → Integrations so Reactive Resume's AI calls work.
RXRESUME_API_KEY=
# Reactive Resume instance. Leave unset for the hosted rxresu.me (opens in a new tab;
# it can't be embedded). Set to a self-hosted copy, e.g. http://localhost:3000, to show
# the editor inside ResumeIQ — RXRESUME_API_KEY must then come from that instance.
# RXRESUME_URL=http://localhost:3000

# Groq (console.groq.com → API Keys) – open-source models for parsing, scoring and job summaries.
# Server-side only; never exposed to the browser.
GROQ_API_KEY=

# PostHog product analytics (optional). Public project key from PostHog → Project settings.
# Only anonymous events with counts/scores are sent – never resume text. Leave empty to disable.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com   (or https://eu.i.posthog.com for an EU project)

# --- Resume LLM (modules M4/M6) ---
# Which model does which job (task = EXTRACT, COMMAND, WRITE, GENERAL). Unset = the default model.
# LLM_EXTRACT_PROVIDER=groq
# LLM_EXTRACT_MODEL=openai/gpt-oss-120b
# LLM_WRITE_PROVIDER=anthropic
# LLM_WRITE_MODEL=claude-haiku-5-5
# AI spend alert: a warning is logged (and posted to the webhook, if set) when a day's spend passes this many USD.
# LLM_DAILY_ALERT_USD=25
# LLM_ALERT_WEBHOOK=
# LLM_PRICES={"model-name":[inputUsdPerMillion,outputUsdPerMillion]}
# Shows today's AI spend at GET /api/llm/spend with header x-admin-key. Hidden when unset.
# ADMIN_KEY=
# Set to 1 to turn the download paywall off (testing, or a free launch period). Downloads aren't counted then.
# DOWNLOADS_FREE=1
# Launch switch (module M9): 1 = /app/editor opens Resume LLM (production build). Unset = it opens the earlier editor.
# Local development always has Resume LLM on. /app/resume-llm opens it regardless.
# VITE_RESUME_LLM=1
